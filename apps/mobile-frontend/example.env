# Prefixed with EXPO_PUBLIC_ so babel-preset-expo inlines it into the bundle.
# NEVER put secrets in EXPO_PUBLIC_ variables — they ship to the client.
# On a physical device via Expo Go, use your machine's LAN IP, not localhost.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# These values are inlined at transform time and Metro caches transforms:
# after editing this file, restart with `--clear` (e.g. `npx expo start --go --clear`).
