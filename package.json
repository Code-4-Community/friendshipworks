{
  "name": "@scaffolding/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "format:check": "prettier --no-error-on-unmatched-pattern --check \"apps/backend/src/**/*.{js,ts,tsx}\" \"apps/mobile-frontend/src/**/*.{js,ts,tsx}\"",
    "format": "prettier --no-error-on-unmatched-pattern --write \"apps/backend/src/**/*.{js,ts,tsx}\" \"apps/mobile-frontend/src/**/*.{js,ts,tsx}\"",
    "lint:check": "nx run-many -t lint",
    "lint": "nx run-many -t lint --fix",
    "mobile": "cd apps/mobile-frontend && npx expo start",
    "prepush": "yarn run format:check && yarn run lint:check",
    "prepush:fix": "yarn run format && yarn run lint",
    "prepare": "husky install",
    "typeorm": "ts-node -r tsconfig-paths/register --project apps/backend/tsconfig.app.json ./node_modules/typeorm/cli.js",
    "migration:generate": "yarn typeorm migration:generate apps/backend/src/migrations/$name -d apps/backend/src/data-source.ts",
    "migration:run": "yarn typeorm migration:run -d apps/backend/src/data-source.ts",
    "migration:revert": "yarn typeorm migration:revert -d apps/backend/src/data-source.ts",
    "migration:create": "yarn typeorm migration:create apps/backend/src/migrations/$name",
    "test": "jest"
  },
  "private": true,
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1058.0",
    "@aws-sdk/client-s3": "^3.1073.0",
    "@aws-sdk/client-sesv2": "^3.1063.0",
    "@expo/metro": "~56.0.0",
    "@expo/metro-config": "~57.0.12",
    "@expo/metro-runtime": "~57.0.15",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/common": "^10.0.2",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^10.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.2.1",
    "@nestjs/swagger": "^7.1.12",
    "@nestjs/typeorm": "^11.0.3",
    "@nx/eslint": "23.2.1",
    "@types/pg": "^8.15.5",
    "axios": "^1.18.1",
    "bottleneck": "^2.19.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "expo": "~57.0.0",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "jsonwebtoken": "^9.0.3",
    "jwks-rsa": "^4.1.0",
    "listr2": "11",
    "nodemailer": "^9.0.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.16.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-svg": "15.15.4",
    "react-native-svg-transformer": "~1.5.1",
    "react-native-web": "~0.21.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typeorm": "^0.3.29"
  },
  "devDependencies": {
    "@eslint/config-array": "^0.23.5",
    "@eslint/eslintrc": "^3.3.6",
    "@expo/cli": "~57.0.25",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^10.0.2",
    "@nx/eslint-plugin": "23.2.1",
    "@nx/expo": "23.2.1",
    "@nx/jest": "23.2.1",
    "@nx/js": "23.2.1",
    "@nx/webpack": "23.2.1",
    "@react-native/jest-preset": "0.86.3",
    "@swc-node/register": "~1.11.1",
    "@swc/core": "~1.15.5",
    "@swc/helpers": "~0.5.18",
    "@testing-library/react-native": "~13.2.0",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.9.3",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@typescript-eslint/eslint-plugin": "8.70.0",
    "@typescript-eslint/parser": "8.70.0",
    "aws-sdk-client-mock": "^4.1.0",
    "babel-jest": "~29.7.0",
    "babel-preset-expo": "~57.0.12",
    "eslint": "9.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-jsx-a11y": "6.10.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "jest-util": "~29.7.0",
    "lint-staged": "^17.1.0",
    "nx": "23.2.1",
    "nx-cloud": "^19.1.3",
    "prettier": "~3.6.2",
    "react-test-renderer": "19.2.3",
    "ts-jest": "^29.4.12",
    "tslib": "^2.3.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.58.0"
  },
  "resolutions": {
    "listr2": "11",
    "@nx/eslint-plugin/@typescript-eslint/utils": "6.21.0"
  }
}
